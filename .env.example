# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://officialheromusic.com

# Neon Postgres (pooled connection string, sslmode=require). New account.
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Production only. Leave unset on Preview and localhost.
BETTER_AUTH_URL=https://officialheromusic.com

# Already set in Vercel
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for POST /api/stripe/webhook
# Events: customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Already set in Vercel. Live merch rates and paid-order sync. VIP checkout skips live rates.
SHIPPO_API_TOKEN=

# Comma-separated emails that can open /admin. Everyone else is denied.
# Set this to exactly the two owners:
# woodnbirdent@gmail.com,hero@officialheromusic.com
ADMIN_EMAILS=

# Resend API key and from-address for admin magic-link sign-in,
# SET APART ticket emails, and sponsorship receipts.
# The from-address domain must be verified in Resend.
# Example: Official #Hero <noreply@officialheromusic.com>
RESEND_API_KEY=
ADMIN_EMAIL_FROM=

# Whole number of SET APART tickets. Checkout stays closed until this is set.
# Capacity is still chosen per show. Count is paid tickets plus unexpired holds.
TICKET_CAPACITY=

# Door password for /checkin. Use a long random value. Preview and production differ.
TICKET_CHECKIN_PASSWORD=

# Optional. Sponsorship notices go to Lee / Woodnbird when this is unset:
# woodnbirdent@gmail.com
OWNER_NOTIFY_EMAIL=
